{
    "name": "ecommerce-recomendations-with-ml",
    "version": "1.0.0",
    "description": "An e-commerce recommendation system with TensorFlow.js",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "start": "browser-sync -w . --server --files \"index.html,data/*.json,js/*.js\" --port 3000",
        "test": "echo \"Error: no test specified\" && exit 1",
        "import:csv": "node scripts/importCsvToPostgres.mjs",
        "embed:books": "node scripts/upsertBookEmbeddings.mjs",
        "embed:users": "node scripts/upsertUserEmbeddings.mjs",
        "embed:all": "node scripts/upsertBookEmbeddings.mjs && node scripts/upsertUserEmbeddings.mjs",
        "recommend:topn": "node scripts/recommendTopN.mjs"
    },
    "keywords": [
        "ecommerce",
        "tensorflow",
        "recommendation",
        "javascript"
    ],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "browser-sync": "^3.0.4"
    },
    "dependencies": {
        "csv-parse": "^6.1.0",
        "dotenv": "^17.3.1",
        "pg": "^8.19.0"
    }
}
